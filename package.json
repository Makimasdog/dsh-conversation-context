{
  "name": "@local/dsh-conversation-context",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Session-local tools, skills, and system prompt controls for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makimasdog/dsh-conversation-context.git"
  },
  "engines": { "dsh": "0.2.2-rc.3" },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "catalog.js", "protocol.js", "dist/client.js", "cordis.patch.yml", "README.md", "assets"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-ui-conversation"] }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test"
  }
}
